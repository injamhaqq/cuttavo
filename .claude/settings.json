{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/reduce-output.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
