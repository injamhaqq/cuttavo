{
    "name": "designbycode/business-name-generator",
    "description": "Generate creative, brandable business names from keywords using a variety of naming patterns and curated word lists.",
    "type": "library",
    "keywords": [
        "business",
        "name",
        "generator",
        "branding",
        "startup",
        "naming",
        "brandable"
    ],
    "homepage": "https://github.com/injamhaqq/cuttavo",
    "license": "MIT",
    "authors": [
        {
            "name": "Md. Injamamul Hoque",
            "email": "md.injamamul.hoque@g.bracu.ac.bd"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Designbycode\\BusinessNameGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Designbycode\\BusinessNameGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
